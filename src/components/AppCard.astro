---
import type { MonitoredApp } from '../lib/apps';
import type { AppStatus, HistoryBucket, HistoryDotStatus } from '../lib/db/checks';
import type { AppMeta } from '../lib/db/meta';

interface Props {
  app: MonitoredApp;
  status: AppStatus;
  meta?: AppMeta;
  loggedIn?: boolean;
}

const { app, status: s, meta, loggedIn = false } = Astro.props;

function dotClass(isUp: boolean | null) {
  if (isUp === null) return '';
  return isUp ? 'lp-dot-up' : 'lp-dot-down lp-dot-pulse';
}

function historyBarClass(status: HistoryDotStatus) {
  return status === null ? undefined : `is-${status}`;
}

// Logged-in only: hover tooltip listing each failed check in the bucket
// (timestamp + reason, e.g. "HTTP 502" or "timeout (15s)").
function failureTooltip(bucket: HistoryBucket) {
  if (!loggedIn || bucket.failures.length === 0) return undefined;
  return bucket.failures
    .map((f) => `${new Date(f.checkedAt).toLocaleTimeString()} — ${f.reason ?? 'unknown error'}`)
    .join('\n');
}

function timeAgo(iso: string | null) {
  if (!iso) return null;
  const diffMs = Date.now() - new Date(iso).getTime();
  const mins = Math.floor(diffMs / 60000);
  if (mins < 60) return `${mins}m ago`;
  const hours = Math.floor(mins / 60);
  if (hours < 24) return `${hours}h ago`;
  const days = Math.floor(hours / 24);
  return `${days}d ago`;
}
---

<article class="lp-card">
  <div class="flex items-center justify-between gap-3 flex-wrap">
    <div class="flex items-center gap-2.5">
      <span class={`lp-dot ${dotClass(s.isUp)}`} />
      <a href={app.url} class="font-display text-lg font-semibold tracking-tight text-text hover:text-accent-h hover:no-underline">
        {app.name}
      </a>
      {meta?.version && <span class="lp-chip">v{meta.version}</span>}
    </div>
    <div class="lp-num text-sm text-muted">
      {s.isUp === null && 'no data yet'}
      {s.isUp === true && `up${s.latencyMs != null ? ` · ${s.latencyMs}ms` : ''}`}
      {s.isUp === false && <span class="text-danger font-semibold">down</span>}
      {s.uptime24h != null && ` · ${s.uptime24h}% (24h)`}
    </div>
  </div>
  {s.history.length > 0 && (
    <>
      <div class="history mt-4" aria-label="Uptime, last 24 hours">
        {s.history.map((bucket) => (
          <span class={historyBarClass(bucket.status)} title={failureTooltip(bucket)} />
        ))}
      </div>
      <div class="mt-1.5 flex justify-between text-[0.7rem] text-overlay" aria-hidden="true">
        <span>24h ago</span>
        <span>now</span>
      </div>
    </>
  )}
  {meta?.lastCommitAt && (
    <p class="lp-num mt-3 text-xs text-overlay">
      last commit {timeAgo(meta.lastCommitAt)} · {meta.lastCommitSha}
    </p>
  )}
</article>
