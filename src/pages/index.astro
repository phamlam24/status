---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppCard from '../components/AppCard.astro';
import { MONITORED_APPS } from '../lib/apps';
import { getAllAppStatuses } from '../lib/db/checks';
import { getAllAppMeta } from '../lib/db/meta';
import { isLoggedIn } from '../lib/auth';
import { AUTH_ORIGIN } from '../lib/authOrigin';

const [statuses, metaByName, loggedIn] = await Promise.all([
  getAllAppStatuses(MONITORED_APPS.map((a) => a.name)),
  getAllAppMeta(),
  isLoggedIn(Astro.request, Astro.cookies),
]);
const statusByName = new Map(statuses.map((s) => [s.name, s]));

const authUp = statusByName.get('auth')?.isUp === true;
const canSeePrivate = loggedIn && authUp;
const visibleApps = MONITORED_APPS.filter((a) => a.public || canSeePrivate);
const hiddenCount = MONITORED_APPS.length - visibleApps.length;

const apps = visibleApps.filter((a) => a.kind === 'app');
const services = visibleApps.filter((a) => a.kind === 'service');

const isLocalhost = Astro.url.hostname === 'localhost' || Astro.url.hostname === '127.0.0.1';
const redirect = encodeURIComponent(Astro.url.href);
const loginUrl = `${AUTH_ORIGIN}/login?redirect=${redirect}`;
const logoutUrl = `${AUTH_ORIGIN}/logout?redirect=${redirect}`;
const authHref = isLocalhost ? undefined : loggedIn ? logoutUrl : loginUrl;

// Headline summary over what this viewer can see.
const visibleStatuses = visibleApps.map((a) => statusByName.get(a.name)!);
const downCount = visibleStatuses.filter((s) => s.isUp === false).length;
const allUnknown = visibleStatuses.every((s) => s.isUp === null);
const summary = allUnknown
  ? { text: 'Waiting for the first checks', dot: '' }
  : downCount === 0
    ? { text: 'All systems operational', dot: 'lp-dot-up' }
    : { text: `${downCount} ${downCount === 1 ? 'system' : 'systems'} down`, dot: 'lp-dot-down lp-dot-pulse' };
---

<BaseLayout title="Status | lampham.space" loggedIn={loggedIn} authHref={authHref}>
  <header class="mb-12">
    <p class="lp-eyebrow">status.lampham.space</p>
    <h1 class="mt-3 flex items-center gap-3 text-3xl sm:text-4xl text-text">
      <span class={`lp-dot size-3 ${summary.dot}`} />
      {summary.text}
    </h1>
    <p class="mt-3 text-muted">Uptime for the *.lampham.space suite, checked every 5 minutes.</p>
    {hiddenCount > 0 && (
      <p class="mt-2 text-sm text-overlay">
        {hiddenCount} internal {hiddenCount === 1 ? 'entry is' : 'entries are'} hidden{!authUp ? ' (auth is down)' : ''}.
      </p>
    )}
  </header>

  {apps.length > 0 && (
    <section class="mb-10">
      <h2 class="lp-eyebrow mb-3">Apps</h2>
      <div class="flex flex-col gap-3">
        {apps.map((app) => (
          <AppCard app={app} status={statusByName.get(app.name)!} meta={metaByName.get(app.name)} loggedIn={loggedIn} />
        ))}
      </div>
    </section>
  )}

  {services.length > 0 && (
    <section>
      <h2 class="lp-eyebrow mb-3">Services</h2>
      <div class="flex flex-col gap-3">
        {services.map((app) => (
          <AppCard app={app} status={statusByName.get(app.name)!} meta={metaByName.get(app.name)} loggedIn={loggedIn} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
