---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { MONITORED_APPS } from '../lib/apps';
import { getAllAppStatuses } from '../lib/db/checks';

const statuses = await getAllAppStatuses(MONITORED_APPS.map((a) => a.name));
const statusByName = new Map(statuses.map((s) => [s.name, s]));

function dotClass(isUp: boolean | null) {
  if (isUp === null) return 'dot--unknown';
  return isUp ? 'dot--up' : 'dot--down';
}
---

<BaseLayout title="Status | lampham.space">
  <header class="mb-10 pb-6 border-b border-border">
    <h1 class="text-2xl font-bold tracking-tight text-text">status.lampham.space</h1>
    <p class="mt-1 text-sm text-muted">Uptime for every app in the *.lampham.space suite, checked every 5 minutes.</p>
  </header>

  <div class="flex flex-col gap-4">
    {MONITORED_APPS.map((app) => {
      const s = statusByName.get(app.name)!;
      return (
        <div class="rounded-lg border border-border bg-surface px-5 py-4">
          <div class="flex items-center justify-between gap-3 flex-wrap">
            <div class="flex items-center gap-2">
              <span class={`dot ${dotClass(s.isUp)}`} />
              <a href={app.url} class="font-semibold text-text hover:text-accent-h transition-colors">
                {app.label}
              </a>
            </div>
            <div class="text-xs text-muted font-mono">
              {s.isUp === null && 'no data yet'}
              {s.isUp === true && `up${s.latencyMs != null ? ` · ${s.latencyMs}ms` : ''}`}
              {s.isUp === false && 'down'}
              {s.uptime24h != null && ` · ${s.uptime24h}% (24h)`}
            </div>
          </div>
          {s.history.length > 0 && (
            <div class="mt-3 flex gap-1 flex-wrap">
              {s.history.map((up) => (
                <span class={`dot ${up ? 'dot--up' : 'dot--down'}`} />
              ))}
            </div>
          )}
        </div>
      );
    })}
  </div>

  <Footer />
</BaseLayout>
