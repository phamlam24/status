# Postgres connection string. Locally, point this at a dev-only database
# (e.g. `lampham_dev`) so migrations can be run freely.
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/lampham

# Must be IDENTICAL to the JWT_SECRET in server-auth's .env — used only to
# decide whether to show login-gated apps/services on the page. On localhost,
# this app always treats the viewer as logged in regardless of this.
JWT_SECRET=change-me-to-a-long-random-value

# Origin of the shared auth service, used by src/middleware.ts to refresh an
# expired access token. Defaults to https://auth.lampham.space if unset.
AUTH_ORIGIN=https://auth.lampham.space

# Must match the COOKIE_DOMAIN/COOKIE_SECURE server-auth is using — only
# relevant to src/middleware.ts, which re-sets the access_token cookie after
# a refresh. Leave unset in production. For local dev over plain http://:
#   COOKIE_DOMAIN=.lampham.test
#   COOKIE_SECURE=false
COOKIE_DOMAIN=.lampham.space
COOKIE_SECURE=true

# GitHub API access for db/check-meta.mjs (fetches each app's latest commit
# + package.json version). Optional locally (60 req/hr unauthenticated is
# plenty for one manual run) but required in production — 6 apps checked
# hourly is within the unauthenticated limit too, but a token avoids ever
# being affected by shared-IP rate limiting on the server.
GITHUB_TOKEN=
